CONFIG_IDF_TARGET="esp32s3"

CONFIG_FREERTOS_HZ=1000

# Without PSRAM the export falls back to internal RAM, which is exactly what
# these tests check it stays out of.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MODE_OCT=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The tests install their own profiles exporter; none of the component's is
# needed.
CONFIG_ESP_OPENTELEMETRY_EXPORTER_OTLP_HTTP=n
CONFIG_ESP_OPENTELEMETRY_EXPORTER_OSTREAM=n
CONFIG_ESP_OPENTELEMETRY_EXPORTER_ESP_LOG=n

CONFIG_ESP_OPENTELEMETRY_PROFILING_ENABLED=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
