CONFIG_IDF_TARGET="esp32s3"

CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Only the instrument created on the 4 KB task is under test; the rest of
# each test, provider setup included, runs on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The tests read metrics back through their own reader; no exporter is needed.
CONFIG_ESP_OPENTELEMETRY_EXPORTER_OTLP_HTTP=n
CONFIG_ESP_OPENTELEMETRY_EXPORTER_OSTREAM=n
CONFIG_ESP_OPENTELEMETRY_EXPORTER_ESP_LOG=n

CONFIG_ESP_OPENTELEMETRY_TRACING_ENABLED=n
CONFIG_ESP_OPENTELEMETRY_METRICS_ENABLED=y
CONFIG_ESP_OPENTELEMETRY_LOGS_ENABLED=n
CONFIG_ESP_OPENTELEMETRY_PROFILING_ENABLED=n
