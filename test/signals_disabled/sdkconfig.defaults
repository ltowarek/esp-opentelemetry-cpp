CONFIG_IDF_TARGET="esp32s3"

CONFIG_FREERTOS_HZ=1000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MODE_OCT=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Every exporter family compiled in, every signal off.
CONFIG_ESP_TRACE_TRANSPORT_APPTRACE=y
CONFIG_APPTRACE_DEST_JTAG=y
CONFIG_ESP_OPENTELEMETRY_EXPORTER_OTLP_HTTP=y
CONFIG_ESP_OPENTELEMETRY_EXPORTER_JTAG=y
CONFIG_ESP_OPENTELEMETRY_EXPORTER_ESP_LOG=y
CONFIG_ESP_OPENTELEMETRY_TRACING_ENABLED=n
CONFIG_ESP_OPENTELEMETRY_METRICS_ENABLED=n
CONFIG_ESP_OPENTELEMETRY_LOGS_ENABLED=n
CONFIG_ESP_OPENTELEMETRY_PROFILING_ENABLED=n
