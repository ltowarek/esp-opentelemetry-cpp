# Profiling alongside a signal, on the console exporters.
#
#   idf.py -B build_tracing \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.tracing" \
#          -D SDKCONFIG=build_tracing/sdkconfig build
#
# The one configuration that compiles the cJSON JsonWriter for the profiles
# exporter while the SDK's OTLP exporter tree - where its JSON seam targets
# live - is not configured at all. Nothing else covers it, and getting the
# distinction wrong fails at link, not at configure.
CONFIG_ESP_OPENTELEMETRY_TRACING_ENABLED=y
